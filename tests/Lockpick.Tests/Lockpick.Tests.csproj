<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test names use underscores; xUnit async-void and naming analyzers are noisy for tests. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lockpick.Core\Lockpick.Core.csproj" />
    <ProjectReference Include="..\..\src\Lockpick.Api\Lockpick.Api.csproj" />
    <ProjectReference Include="..\..\src\Lockpick.Platform.Windows\Lockpick.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\src\Lockpick.GameAdapter.RE1\Lockpick.GameAdapter.RE1.csproj" />
    <ProjectReference Include="..\..\src\Lockpick.App\Lockpick.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
