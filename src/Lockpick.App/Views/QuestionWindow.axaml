<Window Icon="avares://Lockpick/Assets/lockpick.ico"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lockpick.App.ViewModels"
        xmlns:c="using:Lockpick.App.Controls"
        x:Class="Lockpick.App.Views.QuestionWindow"
        x:DataType="vm:QuestionViewModel"
        Title="Lockpick — what just happened?"
        Width="560" SizeToContent="Height" CanResize="False"
        Topmost="True" ShowInTaskbar="True"
        Background="{StaticResource LpBgBrush}">
  <Border Classes="card" Margin="12">
    <StackPanel Spacing="10">
      <StackPanel Classes="cardhead">
        <c:LucideIcon Data="{StaticResource Icon.Flag}" />
        <TextBlock Classes="caption" Text="WHAT JUST HAPPENED?" />
      </StackPanel>
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                 Text="The game did something Lockpick doesn't recognize yet. The game is paused; describe what happened at that moment (a cutscene, an item, a door, a puzzle...) and it resumes when you're done." />
      <TextBlock Classes="mono" Text="{Binding Where, StringFormat='It happened in {0}'}" TextWrapping="Wrap" />
      <TextBlock Classes="label" Text="Around then Lockpick saw" IsVisible="{Binding HasContext}" />
      <ItemsControl ItemsSource="{Binding Context}" IsVisible="{Binding HasContext}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="mono" Text="{Binding StringFormat='  {0}'}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="label" Text="What changed" />
      <ItemsControl ItemsSource="{Binding Changes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="mono" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding PauseProblem}" Classes="warning" TextWrapping="Wrap"
                 IsVisible="{Binding PauseProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBox x:Name="AnswerBox" Text="{Binding Answer}" PlaceholderText="e.g. Barry's cutscene in the dining room" AcceptsReturn="False"
               AutomationProperties.Name="What just happened">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
          <KeyBinding Gesture="Escape" Command="{Binding SkipCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Skip" Command="{Binding SkipCommand}" />
        <Button Content="Save and resume" Command="{Binding SaveCommand}" Classes="accent" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
