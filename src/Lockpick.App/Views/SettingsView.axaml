<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lockpick.App.ViewModels"
             xmlns:c="using:Lockpick.App.Controls"
             xmlns:svc="using:Lockpick.App.Services"
             x:Class="Lockpick.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <c:CardColumns MinColumnWidth="480" MaxColumns="3">

      <!-- Updates -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <StackPanel Classes="cardhead">
            <c:LucideIcon Data="{StaticResource Icon.RefreshCw}" />
            <TextBlock Classes="caption" Text="UPDATES" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="label" Text="Installed version" />
            <TextBlock Classes="mono" Text="{Binding Updates.VersionLabel}" Classes.warning="{Binding Updates.HasUpdate}" />
          </StackPanel>
          <TextBlock Text="{Binding Updates.Status}" TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="Check now" Command="{Binding CheckForUpdatesNowCommand}" IsEnabled="{Binding Updates.IsSupported}" />
            <Button Command="{Binding UpdateNowCommand}" IsVisible="{Binding Updates.HasUpdate}" Classes="accent" AutomationProperties.Name="Update and restart">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:LucideIcon Data="{StaticResource Icon.Download}" Width="14" Height="14" />
                <TextBlock Text="{Binding Updates.AvailableVersion, StringFormat='Update to v{0} and restart'}" />
              </StackPanel>
            </Button>
          </WrapPanel>
          <ProgressBar Classes="health" Minimum="0" Maximum="100" Value="{Binding Updates.Progress}" IsVisible="{Binding Updates.IsBusy}" />
          <ToggleSwitch IsChecked="{Binding CheckForUpdates}" OnContent="Check for updates automatically" OffContent="Check for updates automatically" />
          <ToggleSwitch IsChecked="{Binding IncludePrereleases}" OnContent="Include pre-release versions" OffContent="Include pre-release versions" />
        </StackPanel>
      </Border>

      <!-- Capture -->
      <!-- Overlay -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <StackPanel Classes="cardhead">
            <c:LucideIcon Data="{StaticResource Icon.Gauge}" />
            <TextBlock Classes="caption" Text="OVERLAY" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                     Text="Shows the in-game time, HP, the room and your challenge on top of the game. Clicks go through it and it never takes focus, so the game keeps running. It works with the game windowed, borderless or fullscreen." />
          <ToggleSwitch IsChecked="{Binding OverlayEnabled}" OnContent="Overlay on" OffContent="Overlay off" AutomationProperties.Name="Show the overlay over the game" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <TextBlock Classes="label" Text="Corner" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding OverlayCornerChoices}" SelectedItem="{Binding OverlayCorner}" MinWidth="160" AutomationProperties.Name="Overlay corner" />
          </WrapPanel>
          <TextBlock Text="{Binding Overlay.Status}" TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <StackPanel Classes="cardhead">
            <c:LucideIcon Data="{StaticResource Icon.Flag}" />
            <TextBlock Classes="caption" Text="CAPTURE MARKERS" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                     Text="While a capture is running, this key or controller button marks the current moment even while the game has focus. Pick ones that do nothing in your game (F9 closes Resident Evil; L2 does nothing with the PlayStation layout)." />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <TextBlock Classes="label" Text="Marker hotkey" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding MarkerHotkeyChoices}" SelectedItem="{Binding MarkerHotkey}" MinWidth="160" AutomationProperties.Name="Marker hotkey" />
          </WrapPanel>
          <TextBlock Text="{Binding MarkerHotkeyStatus}" Classes="warning" TextWrapping="Wrap" IsVisible="{Binding MarkerHotkeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <TextBlock Classes="label" Text="Controller button" VerticalAlignment="Center" />
            <TextBlock Classes="mono" Text="{Binding MarkerButtonName}" VerticalAlignment="Center" MinWidth="120" />
            <Button Content="Bind…" Command="{Binding BindMarkerButtonCommand}" AutomationProperties.Name="Bind the controller marker button" />
            <Button Content="L2 / LT" Command="{Binding UseL2ForMarkersCommand}" AutomationProperties.Name="Use L2 or LT for markers" />
            <Button Content="Off" Command="{Binding TurnOffMarkerButtonCommand}" AutomationProperties.Name="No controller button for markers" />
          </WrapPanel>
          <TextBlock Text="{Binding MarkerButtonStatus}" TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                     IsVisible="{Binding MarkerButtonStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- API -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <StackPanel Classes="cardhead">
            <c:LucideIcon Data="{StaticResource Icon.Plug}" />
            <TextBlock Classes="caption" Text="API FOR OTHER TOOLS" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                     Text="Lets scripts, OBS, LiveSplit, a Stream Deck or macro tools read the game state and events, add capture markers and, if you allow it, use trainer commands. Every request needs the token below. See docs/API.md." />
          <CheckBox Content="Turn on the API" IsChecked="{Binding ApiEnabled}" AutomationProperties.Name="Turn on the API" />
          <StackPanel Spacing="8" IsEnabled="{Binding ApiEnabled}">
            <CheckBox Content="Allow other devices on my network (a phone, a Steam Deck, another PC)" IsChecked="{Binding ApiAllowNetwork}"
                      AutomationProperties.Name="Allow other devices on my network" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}" IsVisible="{Binding ApiAllowNetwork}"
                       Text="Windows may ask to allow Lockpick through the firewall. Anyone on your network with the token can use the API." />
            <CheckBox Content="Allow trainer commands (only while Trainer Mode is on)" IsChecked="{Binding ApiAllowTrainer}"
                      AutomationProperties.Name="Allow trainer commands from the API" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <TextBlock Classes="label" Text="Port" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding ApiPort}" Minimum="1024" Maximum="65535" Increment="1" FormatString="0" MinWidth="130"
                             AutomationProperties.Name="API port" />
            </WrapPanel>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <TextBlock Classes="label" Text="Token" VerticalAlignment="Center" />
              <TextBox Classes="mono" Text="{Binding ApiToken}" IsReadOnly="True" MinWidth="260" MaxWidth="460" TextWrapping="Wrap"
                       AutomationProperties.Name="API token" />
              <Button Content="New token" Command="{Binding NewApiTokenCommand}" AutomationProperties.Name="Make a new API token"
                      ToolTip.Tip="Programs using the old token stop working." />
            </WrapPanel>
          </StackPanel>
          <TextBlock Text="{Binding ApiStatus}" TextWrapping="Wrap" Classes.warning="{Binding ApiProblem}" />
        </StackPanel>
      </Border>

      <!-- Trainer hotkeys -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <StackPanel Classes="cardhead">
            <c:LucideIcon Data="{StaticResource Icon.Wrench}" />
            <TextBlock Classes="caption" Text="HOTKEYS" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                     Text="Keys that work while you play, without leaving the game. Trainer actions work only while Trainer Mode is on and Lockpick has write access; the overlay key works any time." />
          <ItemsControl ItemsSource="{Binding TrainerHotkeyRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TrainerHotkeyRow">
                <StackPanel Spacing="2" Margin="0,2">
                  <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <TextBlock Classes="label" Text="{Binding Name}" VerticalAlignment="Center" MinWidth="180" />
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Key}" MinWidth="160"
                              AutomationProperties.Name="{Binding Name}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding Status}" Classes="warning" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Game -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <StackPanel Classes="cardhead">
            <c:LucideIcon Data="{StaticResource Icon.Gamepad}" />
            <TextBlock Classes="caption" Text="GAME INSTALLATION" />
          </StackPanel>
          <TextBlock Text="{Binding DetectedInstall}" TextWrapping="Wrap" />
          <TextBlock Classes="label" Text="Executable override (leave empty to use the detected GOG install)" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding GameExecutablePath}" PlaceholderText="e.g. D:\Games\Resident Evil\ResidentEvil.exe" FontFamily="{StaticResource LpMono}" />
            <Button Grid.Column="1" Content="Browse..." Click="OnBrowse" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Check build" Command="{Binding CheckInstalledBuildCommand}" />
            <Button Content="Save" Command="{Binding SaveCommand}" />
            <TextBlock Text="{Binding SaveResult}" VerticalAlignment="Center" Foreground="{StaticResource LpMutedBrush}" />
          </StackPanel>
          <SelectableTextBlock Classes="mono" Text="{Binding BuildCheckResult}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Credits -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Classes="cardhead">
            <c:LucideIcon Data="{StaticResource Icon.Users}" />
            <TextBlock Classes="caption" Text="CREDITS" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                     Text="Lockpick is free and built with help from its community. Capture a play session (Debug page) or complete a bounty to be listed here — contributions are unpaid; the credit is the reward." />
          <ItemsControl ItemsSource="{Binding Credits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="svc:CreditSection">
                <StackPanel Spacing="4" Margin="0,4,0,6">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="svc:CreditEntry">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" Foreground="{StaticResource LpGreenBrush}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}" Foreground="{StaticResource LpMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Nobody yet — this could be you." Foreground="{StaticResource LpMutedBrush}" FontStyle="Italic" IsVisible="{Binding IsEmpty}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Setup and data -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="caption" Text="SETUP AND DATA" />
          <Button Content="Run first-time setup again" Command="{Binding RunSetupCommand}" />
          <TextBlock Classes="label" Text="Lockpick data folder (logs, captures, settings)" />
          <SelectableTextBlock Classes="mono" Text="{Binding DataFolder}" />
        </StackPanel>
      </Border>

      <!-- Profiles -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <StackPanel Classes="cardhead">
            <c:LucideIcon Data="{StaticResource Icon.Fingerprint}" />
            <TextBlock Classes="caption" Text="VERSION PROFILES" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                     Text="Built-in profiles are embedded. Additional or overriding profiles (*.json) are loaded at startup from:" />
          <SelectableTextBlock Classes="mono" Text="{Binding ProfileDirectory}" />
          <TextBlock Classes="label" Text="Loaded" />
          <SelectableTextBlock Classes="mono" Text="{Binding LoadedProfiles}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </c:CardColumns>
  </ScrollViewer>
</UserControl>
