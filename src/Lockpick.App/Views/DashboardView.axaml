<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lockpick.App.ViewModels"
             xmlns:c="using:Lockpick.App.Controls"
             x:Class="Lockpick.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <!-- Two columns when wide; a single stacked column in narrow/portrait windows (see code-behind). -->
  <Grid x:Name="Root" ColumnSpacing="12" RowSpacing="12">

    <!-- Connection -->
    <Border x:Name="ConnectionCard" Classes="card">
      <StackPanel Spacing="4">
        <StackPanel Classes="cardhead">
          <c:LucideIcon Data="{StaticResource Icon.Plug}" />
          <TextBlock Classes="caption" Text="CONNECTION" />
        </StackPanel>
        <TextBlock Classes="headline" Text="{Binding ConnectionTitle}" />
        <TextBlock Text="{Binding ConnectionMessage}" TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}" />
        <TextBlock Classes="mono" Text="{Binding ProcessText}" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <!-- Build -->
    <Border x:Name="BuildCard" Classes="card">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
        <StackPanel Grid.ColumnSpan="2" Classes="cardhead">
          <c:LucideIcon Data="{StaticResource Icon.Fingerprint}" />
          <TextBlock Classes="caption" Text="EXECUTABLE FINGERPRINT" />
        </StackPanel>
        <TextBlock Grid.Row="1" Classes="label" Text="Profile" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfileText}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Classes="label" Text="File" />
        <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding FileText}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="3" Classes="label" Text="SHA-256" />
        <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="mono" Text="{Binding HashText}" TextWrapping="Wrap" FontSize="11" />
        <TextBlock Grid.Row="4" Classes="label" Text="PE" />
        <TextBlock Grid.Row="4" Grid.Column="1" Classes="mono" Text="{Binding PeText}" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!-- Game state -->
    <Border x:Name="StateCard" Classes="card">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Classes="cardhead">
          <c:LucideIcon Data="{StaticResource Icon.HeartPulse}" />
          <TextBlock Classes="caption" Text="GAME STATE" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Spacing="4">
          <TextBlock Classes="label" Text="Health" />
          <ProgressBar Classes="health" Classes.low="{Binding HealthLow}" Classes.critical="{Binding HealthCritical}"
                       Minimum="0" Maximum="1" Value="{Binding HealthRatio}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FieldRow">
              <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" Margin="0,5">
                <TextBlock Classes="label" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Classes="value" Classes.inactive="{Binding IsInactive}" Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="2" Classes="chip" Classes.valid="{Binding IsValid}" Classes.stale="{Binding IsStale}">
                  <TextBlock Text="{Binding StatusText}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- Events -->
    <Border x:Name="EventsCard" Classes="card" MinHeight="160">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Classes="cardhead">
          <c:LucideIcon Data="{StaticResource Icon.ScrollText}" />
          <TextBlock Classes="caption" Text="EVENT LOG" />
        </StackPanel>
        <ListBox ItemsSource="{Binding State.Events}" Background="Transparent">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="4,3" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
            <Style Selector="ListBoxItem" x:DataType="vm:EventItem"><Setter Property="AutomationProperties.Name" Value="{Binding Text}" /></Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EventItem">
              <Grid ColumnDefinitions="96,*">
                <TextBlock Classes="mono" Text="{Binding Time}" Foreground="{StaticResource LpMutedBrush}" FontSize="11.5" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" Classes.warning="{Binding IsWarning}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
