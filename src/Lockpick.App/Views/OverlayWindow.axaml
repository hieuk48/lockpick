<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lockpick.App.ViewModels"
        xmlns:c="using:Lockpick.App.Controls"
        x:Class="Lockpick.App.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="Lockpick overlay host"
        SystemDecorations="None" ShowInTaskbar="False" ShowActivated="False" Background="Transparent">

  <!-- Never shown: each widget is rendered to a picture that its own plain layered window shows over the game
       (OverlayController, LayeredWindow). No templated controls or style classes here — the window never runs its
       styling — so the bar and colours come straight from the model; the scale is set when rendering. The widgets
       overlap here; each is measured and rendered on its own. -->
  <Panel>
  <LayoutTransformControl x:Name="StatusPanel">
    <Border Background="#C80B0F0E" BorderBrush="{StaticResource LpBorderBrush}" BorderThickness="1" CornerRadius="3"
            Padding="7,4" MinWidth="120">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Time}" FontFamily="{StaticResource LpMono}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource LpTextBrush}" HorizontalAlignment="Right" />
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" IsVisible="{Binding Health, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding Condition}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding HealthBrush}"
                     IsVisible="{Binding Condition, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Grid.Column="1" Text="{Binding Health}" FontFamily="{StaticResource LpMono}" FontSize="10" Foreground="{StaticResource LpMutedBrush}" />
          <Border Grid.Column="2" Width="70" Height="4" CornerRadius="1" Background="{StaticResource LpPanelAltBrush}"
                  VerticalAlignment="Center" HorizontalAlignment="Right">
            <Border Width="{Binding HealthBarWidth}" CornerRadius="1" Background="{Binding HealthBrush}" HorizontalAlignment="Left" />
          </Border>
        </Grid>
        <TextBlock Text="{Binding Room}" FontSize="9" Foreground="{StaticResource LpMutedBrush}" HorizontalAlignment="Right"
                   IsVisible="{Binding Room, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding Challenge}" Foreground="{Binding ChallengeBrush}" FontSize="9"
                   FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="220" IsVisible="{Binding HasChallenge}" />
      </StackPanel>
    </Border>
  </LayoutTransformControl>

  <!-- Run splits; rows are built in code (OverlayWindow.ShowSplits). -->
  <LayoutTransformControl x:Name="SplitsPanel">
    <Border Background="#C80B0F0E" BorderBrush="{StaticResource LpBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="7,4" Width="190">
      <StackPanel x:Name="SplitList" Spacing="1" />
    </Border>
  </LayoutTransformControl>

  <!-- Enemies in the room with their HP; rows are built in code (OverlayWindow.ShowEnemies: no templates here). -->
  <LayoutTransformControl x:Name="EnemiesPanel">
    <Border Background="#C80B0F0E" BorderBrush="{StaticResource LpBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="7,4" MinWidth="120">
      <StackPanel x:Name="EnemyList" Spacing="3" />
    </Border>
  </LayoutTransformControl>

  <!-- Map: north-up. The minimap (the area around the player, framed, no names) or the whole room over the picture,
       framed or see-through (the map key cycles the player's chosen views). -->
  <LayoutTransformControl x:Name="MinimapPanel">
    <Border Background="{Binding MinimapBackdrop}" BorderBrush="{Binding MinimapBorder}" BorderThickness="1" CornerRadius="3" Padding="2">
      <c:RoomMapControl FloorBrush="{Binding MinimapFloor}" Width="{Binding MinimapWidth}" Height="{Binding MinimapHeight}" ClipToBounds="True"
                        ShowLabels="{Binding MinimapNames}" Opacity="{Binding MinimapOpacity}"
                        ViewRadius="{Binding MinimapViewRadius}"
                        Map="{Binding Map.Map}" PlacedItems="{Binding Map.PlacedItems}" TakenItems="{Binding Map.TakenItems}"
                        FilledSockets="{Binding Map.FilledSockets}" DoorNames="{Binding Map.DoorNames}" Actors="{Binding Map.Actors}" LiveFixtures="{Binding Map.LiveFixtures}"
                        PlayerX="{Binding Map.PlayerX}" PlayerZ="{Binding Map.PlayerZ}" PlayerAngle="{Binding Map.PlayerAngle}" HasPlayer="{Binding Map.HasPlayer}"
                        WallBrush="{Binding MinimapWalls}" SoftBrush="#33423C"
                        DoorBrush="{StaticResource LpGreenBrush}" ItemBrush="{StaticResource LpAmberBrush}"
                        PlayerBrush="{StaticResource LpRedBrush}" FaintTextBrush="{StaticResource LpMutedBrush}"
                        LabelPlateBrush="{StaticResource LpBgBrush}" />
    </Border>
  </LayoutTransformControl>
  </Panel>
</Window>
