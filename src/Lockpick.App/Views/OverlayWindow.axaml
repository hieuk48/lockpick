<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lockpick.App.ViewModels"
        x:Class="Lockpick.App.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="Lockpick overlay host"
        SystemDecorations="None" ShowInTaskbar="False" ShowActivated="False" Background="Transparent">

  <!-- Never shown: the panel is rendered to a picture that a plain layered window shows over the game
       (OverlayController, LayeredWindow). No templated controls or style classes here — the window never runs its
       styling — so the bar and colours come straight from the model; the scale is set when rendering. -->
  <LayoutTransformControl x:Name="Panel">
    <Border Background="#C80B0F0E" BorderBrush="{StaticResource LpBorderBrush}" BorderThickness="1" CornerRadius="3"
            Padding="7,4" MinWidth="120">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Time}" FontFamily="{StaticResource LpMono}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource LpTextBrush}" HorizontalAlignment="Right" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding Health, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding Health}" FontFamily="{StaticResource LpMono}" FontSize="10" Foreground="{StaticResource LpMutedBrush}" />
          <Border Grid.Column="1" Width="70" Height="4" CornerRadius="1" Background="{StaticResource LpPanelAltBrush}"
                  VerticalAlignment="Center" HorizontalAlignment="Right">
            <Border Width="{Binding HealthBarWidth}" CornerRadius="1" Background="{Binding HealthBrush}" HorizontalAlignment="Left" />
          </Border>
        </Grid>
        <TextBlock Text="{Binding Room}" FontSize="9" Foreground="{StaticResource LpMutedBrush}" HorizontalAlignment="Right"
                   IsVisible="{Binding Room, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding Challenge}" Foreground="{Binding ChallengeBrush}" FontSize="9"
                   FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="220" IsVisible="{Binding HasChallenge}" />
      </StackPanel>
    </Border>
  </LayoutTransformControl>
</Window>
