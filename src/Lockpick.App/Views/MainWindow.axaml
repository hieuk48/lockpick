<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lockpick.App.ViewModels"
        xmlns:c="using:Lockpick.App.Controls"
        x:Class="Lockpick.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Lockpick Trainer"
        Width="1180" Height="780" MinWidth="380" MinHeight="400"
        Icon="avares://Lockpick/Assets/lockpick.ico"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Border.navpane"><Setter Property="Width" Value="180" /></Style>
    <Style Selector="ContentControl.page"><Setter Property="Margin" Value="16" /></Style>
    <Style Selector="Border.header"><Setter Property="Padding" Value="18,12" /></Style>
    <!-- Special Elite's capitals sit 0.14 em above the middle of its line box (ascent 1440, descent 608, caps 1469 of
         2048 units), so the wordmark is moved down by that much to line up with the icon, and the tagline (14 px) down
         to share the wordmark's baseline. RenderTransform leaves the layout alone. -->
    <Style Selector="TextBlock.wordmark"><Setter Property="FontSize" Value="26" /><Setter Property="LetterSpacing" Value="3" /><Setter Property="RenderTransform" Value="translateY(3.7px)" /></Style>
    <Style Selector="TextBlock.tagline"><Setter Property="FontSize" Value="14" /><Setter Property="RenderTransform" Value="translateY(6px)" /></Style>
    <Style Selector="Image.logo"><Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /></Style>
    <!-- Screen readers and UI automation name each page by its title (they read the view-model type otherwise). -->
    <Style Selector="ListBox.nav ListBoxItem" x:DataType="vm:PageViewModel"><Setter Property="AutomationProperties.Name" Value="{Binding Title}" /></Style>
    <Style Selector="ListBox.nav ListBoxItem:selected c|LucideIcon"><Setter Property="Foreground" Value="{StaticResource LpGreenBrush}" /></Style>
    <!-- Compact layout for narrow/portrait windows: icon-only navigation rail, no tagline. -->
    <Style Selector="Grid#Shell.compact TextBlock.tagline"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Grid#Shell.compact Border.navpane"><Setter Property="Width" Value="56" /></Style>
    <Style Selector="Grid#Shell.compact TextBlock.navlabel"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Grid#Shell.compact Button.version"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Button.version">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Foreground" Value="{StaticResource LpMutedBrush}" />
    </Style>
    <Style Selector="Button.version.update">
      <Setter Property="Foreground" Value="{StaticResource LpGreenBrush}" />
    </Style>
    <Style Selector="Grid#Shell.compact Border.navhead"><Setter Property="Padding" Value="10,10" /></Style>
    <!-- A page's sections: under it in the navigation; in the compact layout, a row above the page instead. -->
    <Style Selector="Grid#Shell.compact Border.subnavhost"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Border.sectionbarhost"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Grid#Shell.compact Border.sectionbarhost"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="Grid#Shell.compact ContentControl.page"><Setter Property="Margin" Value="8" /></Style>
    <Style Selector="Grid#Shell.compact TextBlock.wordmark"><Setter Property="FontSize" Value="21" /><Setter Property="LetterSpacing" Value="2" /><Setter Property="RenderTransform" Value="translateY(3px)" /></Style>
    <Style Selector="Grid#Shell.compact Image.logo"><Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /></Style>
    <Style Selector="Grid#Shell.compact Border.header"><Setter Property="Padding" Value="12,10" /></Style>
  </Window.Styles>

  <Grid x:Name="Shell" RowDefinitions="Auto,*" c:Responsive.CompactBelow="760">
    <!-- Header -->
    <Border Grid.Row="0" Classes="header" Background="{StaticResource LpPanelBrush}" BorderBrush="{StaticResource LpBorderBrush}" BorderThickness="0,0,0,1">
      <!-- The brand keeps its width; the status badge takes what is left and shortens itself in a narrow window. -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="2" Padding="10,4"
                Background="{StaticResource LpPanelAltBrush}"
                Classes.connected="{Binding IsConnected}" Classes.unsupported="{Binding IsUnsupported}" Classes.replay="{Binding IsReplaying}">
          <Border.Styles>
            <!-- Defaults as styles, not local values: a local Foreground/Fill would beat the state styles below. -->
            <Style Selector="TextBlock"><Setter Property="Foreground" Value="{StaticResource LpMutedBrush}" /></Style>
            <Style Selector="Ellipse"><Setter Property="Fill" Value="{StaticResource LpMutedBrush}" /></Style>
            <Style Selector="Border.connected"><Setter Property="Background" Value="{StaticResource LpGreenDimBrush}" /></Style>
            <Style Selector="Border.connected TextBlock"><Setter Property="Foreground" Value="{StaticResource LpGreenBrush}" /></Style>
            <Style Selector="Border.connected Ellipse"><Setter Property="Fill" Value="{StaticResource LpGreenBrush}" /></Style>
            <Style Selector="Border.unsupported"><Setter Property="Background" Value="{StaticResource LpRedDimBrush}" /></Style>
            <Style Selector="Border.unsupported TextBlock"><Setter Property="Foreground" Value="{StaticResource LpRedBrush}" /></Style>
            <Style Selector="Border.unsupported Ellipse"><Setter Property="Fill" Value="{StaticResource LpRedBrush}" /></Style>
            <Style Selector="Border.replay"><Setter Property="Background" Value="{StaticResource LpAmberDimBrush}" /></Style>
            <Style Selector="Border.replay TextBlock"><Setter Property="Foreground" Value="{StaticResource LpAmberBrush}" /></Style>
            <Style Selector="Border.replay Ellipse"><Setter Property="Fill" Value="{StaticResource LpAmberBrush}" /></Style>
          </Border.Styles>
          <DockPanel>
            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding HeaderStatus}" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.4"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HeaderStatus}" />
          </DockPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Image Classes="logo" Source="avares://Lockpick/Assets/lockpick-256.png" VerticalAlignment="Center" />
            <TextBlock Classes="wordmark" Text="LOCKPICK" FontFamily="{StaticResource LpWordmark}" Foreground="{StaticResource LpGreenBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="tagline" Text="Master of Unlocking." FontFamily="{StaticResource LpWordmark}" Foreground="{StaticResource LpMutedBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- First-time setup replaces the main UI until completed. -->
    <ContentControl Grid.Row="1" Content="{Binding Setup}" IsVisible="{Binding IsSetupVisible}" />

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" IsVisible="{Binding !IsSetupVisible}">
      <!-- Navigation -->
      <Border Grid.Column="0" Classes="navpane" Background="{StaticResource LpPanelBrush}" BorderBrush="{StaticResource LpBorderBrush}" BorderThickness="0,0,1,0" Padding="8,12">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Classes="version" Command="{Binding OpenUpdatesCommand}" Classes.update="{Binding Updates.HasUpdate}"
                  ToolTip.Tip="{Binding Updates.Status}" AutomationProperties.Name="Version and updates" HorizontalAlignment="Left" Margin="4,0">
            <TextBlock Text="{Binding Updates.VersionLabel}" FontSize="11" TextTrimming="CharacterEllipsis" />
          </Button>
            <ListBox Classes="nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PageViewModel">
                  <StackPanel>
                    <Border Classes="navhead" Classes.current="{Binding $parent[ListBoxItem].IsSelected}">
                      <StackPanel Orientation="Horizontal" Spacing="10" ToolTip.Tip="{Binding Title}">
                        <c:LucideIcon Data="{Binding IconKey, Converter={x:Static c:IconKeyConverter.Instance}}" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Classes="navlabel" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <!-- The selected page's sections, under it. -->
                    <Border Classes="subnavhost">
                      <Panel IsVisible="{Binding HasSections}">
                      <ListBox Classes="subnav" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                               IsVisible="{Binding $parent[ListBoxItem].IsSelected}" AutomationProperties.Name="{Binding Title}">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:PageSection">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      </Panel>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
      </Border>

      <!-- Page content (in the compact layout, the page's sections as a row above it) -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Border Classes="sectionbarhost" Padding="8,8,8,0">
          <ListBox Classes="sectionbar" ItemsSource="{Binding SelectedPage.Sections}" SelectedItem="{Binding SelectedPage.SelectedSection}"
                   IsVisible="{Binding SelectedPage.HasSections}" AutomationProperties.Name="Sections">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PageSection">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <ContentControl Grid.Row="1" Classes="page" Content="{Binding SelectedPage}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
