<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lockpick.App.ViewModels"
             xmlns:views="using:Lockpick.App.Views"
             xmlns:c="using:Lockpick.App.Controls"
             x:Class="Lockpick.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Lockpick/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    <!-- Palette "Status screen": the game's status screen (ECG green on the dark ground, red for danger). -->
    <Color x:Key="LpBg">#0B0F0E</Color>
    <Color x:Key="LpPanel">#121A18</Color>
    <Color x:Key="LpPanelAlt">#161E1C</Color>
    <Color x:Key="LpBorder">#27322F</Color>
    <Color x:Key="LpText">#DFE8E3</Color>
    <Color x:Key="LpMuted">#8FA39B</Color>
    <Color x:Key="LpGreen">#4EC36D</Color>
    <Color x:Key="LpGreenDim">#15321F</Color>
    <Color x:Key="LpAmber">#D6A23E</Color>
    <Color x:Key="LpAmberDim">#3A2D12</Color>
    <Color x:Key="LpRed">#E0533F</Color>
    <Color x:Key="LpRedDim">#3D1913</Color>
    <SolidColorBrush x:Key="LpBgBrush" Color="{StaticResource LpBg}" />
    <SolidColorBrush x:Key="LpPanelBrush" Color="{StaticResource LpPanel}" />
    <SolidColorBrush x:Key="LpPanelAltBrush" Color="{StaticResource LpPanelAlt}" />
    <SolidColorBrush x:Key="LpBorderBrush" Color="{StaticResource LpBorder}" />
    <SolidColorBrush x:Key="LpTextBrush" Color="{StaticResource LpText}" />
    <SolidColorBrush x:Key="LpMutedBrush" Color="{StaticResource LpMuted}" />
    <SolidColorBrush x:Key="LpGreenBrush" Color="{StaticResource LpGreen}" />
    <SolidColorBrush x:Key="LpGreenDimBrush" Color="{StaticResource LpGreenDim}" />
    <SolidColorBrush x:Key="LpAmberBrush" Color="{StaticResource LpAmber}" />
    <SolidColorBrush x:Key="LpAmberDimBrush" Color="{StaticResource LpAmberDim}" />
    <SolidColorBrush x:Key="LpRedBrush" Color="{StaticResource LpRed}" />
    <SolidColorBrush x:Key="LpRedDimBrush" Color="{StaticResource LpRedDim}" />
    <FontFamily x:Key="LpMono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <!-- Wordmark: Special Elite (typewriter, Apache 2.0, Assets/Fonts/LICENSE.txt). -->
    <FontFamily x:Key="LpWordmark">avares://Lockpick/Assets/Fonts#Special Elite</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:DashboardViewModel">
      <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="vm:ProgressViewModel">
      <views:ProgressView />
    </DataTemplate>
    <DataTemplate DataType="vm:ItemsViewModel">
      <views:ItemsView />
    </DataTemplate>
    <DataTemplate DataType="vm:ChallengesViewModel">
      <views:ChallengesView />
    </DataTemplate>
    <DataTemplate DataType="vm:TrainerViewModel">
      <views:TrainerView />
    </DataTemplate>
    <DataTemplate DataType="vm:MapViewModel">
      <views:MapView />
    </DataTemplate>
    <DataTemplate DataType="vm:DebugViewModel">
      <views:DebugView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:SetupViewModel">
      <views:SetupView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <!-- The brand green as the accent, so checkboxes, sliders and the like match the switches. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#4EC36D" />
        <ColorPaletteResources x:Key="Light" Accent="#4EC36D" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource LpBgBrush}" />
      <Setter Property="Foreground" Value="{StaticResource LpTextBrush}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource LpPanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LpBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.6" />
      <Setter Property="Foreground" Value="{StaticResource LpMutedBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="StackPanel.cardhead">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="StackPanel.cardhead > TextBlock.caption">
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.cardhead > c|LucideIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource LpMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource LpMutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource LpMono}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontFamily" Value="{StaticResource LpMono}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.headline">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="2" />
    </Style>

    <!-- Field quality chips -->
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{StaticResource LpPanelAltBrush}" />
    </Style>
    <Style Selector="Border.chip > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{StaticResource LpMutedBrush}" />
    </Style>
    <Style Selector="Border.chip.valid">
      <Setter Property="Background" Value="{StaticResource LpGreenDimBrush}" />
    </Style>
    <Style Selector="Border.chip.valid > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LpGreenBrush}" />
    </Style>
    <Style Selector="Border.chip.stale">
      <Setter Property="Background" Value="{StaticResource LpAmberDimBrush}" />
    </Style>
    <Style Selector="Border.chip.stale > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LpAmberBrush}" />
    </Style>
    <Style Selector="Border.chip.bad">
      <Setter Property="Background" Value="{StaticResource LpRedDimBrush}" />
    </Style>
    <Style Selector="Border.chip.bad > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LpRedBrush}" />
    </Style>
    <Style Selector="TextBlock.inactive">
      <Setter Property="Foreground" Value="{StaticResource LpMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.warning, SelectableTextBlock.warning">
      <Setter Property="Foreground" Value="{StaticResource LpRedBrush}" />
    </Style>

    <!-- Navigation -->
    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource LpGreenDimBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LpGreenBrush}" />
    </Style>

    <!-- Primary action button in the Lockpick palette (Fluent's accent is blue). -->
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource LpGreenBrush}" />
      <Setter Property="Foreground" Value="#07130B" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#68D292" />
      <Setter Property="Foreground" Value="#07130B" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3E9F62" />
    </Style>

    <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource LpGreenDimBrush}" />
      <Setter Property="Foreground" Value="{StaticResource LpMutedBrush}" />
    </Style>

    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{StaticResource LpGreenBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LpGreenBrush}" />
    </Style>
    <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="#68D292" />
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
      <Setter Property="Fill" Value="#07130B" />
    </Style>

    <Style Selector="ProgressBar.health">
      <Setter Property="Foreground" Value="{StaticResource LpGreenBrush}" />
      <Setter Property="Background" Value="{StaticResource LpPanelAltBrush}" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="1" />
    </Style>
    <Style Selector="ProgressBar.health.low">
      <Setter Property="Foreground" Value="{StaticResource LpAmberBrush}" />
    </Style>
    <Style Selector="ProgressBar.health.critical">
      <Setter Property="Foreground" Value="{StaticResource LpRedBrush}" />
    </Style>
  </Application.Styles>
</Application>
