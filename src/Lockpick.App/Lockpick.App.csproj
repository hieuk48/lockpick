<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Lockpick.App</RootNamespace>
    <AssemblyName>Lockpick</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lockpick.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Lockpick Trainer desktop application.</Description>
    <!-- CA1822: view-model members are bound from XAML and must stay instance members. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lockpick.Core\Lockpick.Core.csproj" />
    <ProjectReference Include="..\Lockpick.Api\Lockpick.Api.csproj" />
    <ProjectReference Include="..\Lockpick.Platform.Windows\Lockpick.Platform.Windows.csproj" />
    <ProjectReference Include="..\Lockpick.GameAdapter.RE1\Lockpick.GameAdapter.RE1.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Branding: made by tools/branding/make_icon.py; wordmark font is Special Elite. -->
    <AvaloniaResource Include="Assets\lockpick.ico" />
    <AvaloniaResource Include="Assets\lockpick-256.png" />
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <!-- Single source for the in-app credits (Settings -> Credits). -->
    <EmbeddedResource Include="..\..\CONTRIBUTORS.md" LogicalName="Lockpick.App.CONTRIBUTORS.md" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lockpick.Tests" />
  </ItemGroup>
</Project>
