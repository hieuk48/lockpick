<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DEVELOPER TOOL ONLY. Drives the game with a virtual Xbox 360 controller (ViGEmBus) for automated tests of
    Lockpick against the live game. It is never part of the app, its installer or a release (release.yml publishes
    only Lockpick.App and Lockpick.Probe): Lockpick enhances real play, it doesn't play for people.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Lockpick.Autoplay</RootNamespace>
    <AssemblyName>lockpick-autoplay</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <Description>Developer-only test harness: virtual controller input, game-state checks and screenshots.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lockpick.Core\Lockpick.Core.csproj" />
    <ProjectReference Include="..\..\src\Lockpick.Platform.Windows\Lockpick.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\src\Lockpick.GameAdapter.RE1\Lockpick.GameAdapter.RE1.csproj" />
  </ItemGroup>
</Project>
