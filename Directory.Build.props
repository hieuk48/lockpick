<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <Version>0.3.0</Version>
    <Authors>Lockpick contributors</Authors>
    <Product>Lockpick Trainer</Product>
    <Copyright>Copyright (c) Lockpick contributors</Copyright>
    <!-- CA1848/CA1873: LoggerMessage source generators are overkill for the low log volume here. -->
    <!-- CA1000: Field<T>.Valid/Unsupported static factories are the intended API. -->
    <!-- CA2254: log templates are constant; the analyzer misfires on interpolated helper wrappers. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2254;CA1000</NoWarn>
  </PropertyGroup>
</Project>
